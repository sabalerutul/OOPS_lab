
#include <iostream>
#include <fstream>
using namespace std;

int main()
{
    ifstream fin;
    ofstream fout;

    char ch;

    // Open source file
    fin.open("source.txt");

    if (!fin)
    {
        cout << "Source file cannot be opened!";
        return 1;
    }

    // Open destination file
    fout.open("destination.txt");

    if (!fout)
    {
        cout << "Destination file cannot be opened!";
        fin.close();
        return 1;
    }

    // Copy contents from source to destination
    while (fin.get(ch))
    {
        fout.put(ch);
    }

    cout << "File copied successfully!";

    // Close both files
    fin.close();
    fout.close();

    return 0;
}
